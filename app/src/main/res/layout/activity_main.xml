<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#DCEAFB"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/titleBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="#FFFFFF"
            android:elevation="4dp"
            android:gravity="center"
            android:padding="16dp"
            android:shadowColor="#888888"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="2"
            android:text="Sandy's Knit Counter"
            android:textColor="#2A4D69"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/counterCountLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="Counters on screen"
            android:textColor="#2A4D69"
            android:textSize="16sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/counterCountGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/counterCountOne"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1" />

            <RadioButton
                android:id="@+id/counterCountTwo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2" />

            <RadioButton
                android:id="@+id/counterCountThree"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3" />

            <RadioButton
                android:id="@+id/counterCountFour"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4" />
        </RadioGroup>

        <LinearLayout
            android:id="@+id/counterPanelOne"
            style="@style/CounterPanel">

            <TextView
                android:id="@+id/counterTitleOne"
                style="@style/CounterLabel"
                android:text="Counter 1" />

            <TextView
                android:id="@+id/counterTextViewOne"
                style="@style/CounterValue"
                android:text="0" />

            <LinearLayout style="@style/CounterButtonRow">

                <Button
                    android:id="@+id/decrementButtonOne"
                    style="@style/CounterButton"
                    android:text="-" />

                <Button
                    android:id="@+id/resetButtonOne"
                    style="@style/CounterResetButton"
                    android:text="Reset" />

                <Button
                    android:id="@+id/incrementButtonOne"
                    style="@style/CounterButton"
                    android:text="+" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/counterPanelTwo"
            style="@style/CounterPanel">

            <TextView
                android:id="@+id/counterTitleTwo"
                style="@style/CounterLabel"
                android:text="Counter 2" />

            <TextView
                android:id="@+id/counterTextViewTwo"
                style="@style/CounterValue"
                android:text="0" />

            <LinearLayout style="@style/CounterButtonRow">

                <Button
                    android:id="@+id/decrementButtonTwo"
                    style="@style/CounterButton"
                    android:text="-" />

                <Button
                    android:id="@+id/resetButtonTwo"
                    style="@style/CounterResetButton"
                    android:text="Reset" />

                <Button
                    android:id="@+id/incrementButtonTwo"
                    style="@style/CounterButton"
                    android:text="+" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/counterPanelThree"
            style="@style/CounterPanel">

            <TextView
                android:id="@+id/counterTitleThree"
                style="@style/CounterLabel"
                android:text="Counter 3" />

            <TextView
                android:id="@+id/counterTextViewThree"
                style="@style/CounterValue"
                android:text="0" />

            <LinearLayout style="@style/CounterButtonRow">

                <Button
                    android:id="@+id/decrementButtonThree"
                    style="@style/CounterButton"
                    android:text="-" />

                <Button
                    android:id="@+id/resetButtonThree"
                    style="@style/CounterResetButton"
                    android:text="Reset" />

                <Button
                    android:id="@+id/incrementButtonThree"
                    style="@style/CounterButton"
                    android:text="+" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/counterPanelFour"
            style="@style/CounterPanel">

            <TextView
                android:id="@+id/counterTitleFour"
                style="@style/CounterLabel"
                android:text="Counter 4" />

            <TextView
                android:id="@+id/counterTextViewFour"
                style="@style/CounterValue"
                android:text="0" />

            <LinearLayout style="@style/CounterButtonRow">

                <Button
                    android:id="@+id/decrementButtonFour"
                    style="@style/CounterButton"
                    android:text="-" />

                <Button
                    android:id="@+id/resetButtonFour"
                    style="@style/CounterResetButton"
                    android:text="Reset" />

                <Button
                    android:id="@+id/incrementButtonFour"
                    style="@style/CounterButton"
                    android:text="+" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
